{
  "name": "goui-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "npm run assets && sst deploy --stage dev",
    "deploy:prod": "npm run assets && sst deploy --stage production",
    "remove:dev": "sst remove --stage dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "sst": "^4.17.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
