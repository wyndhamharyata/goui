#!/bin/sh
# The goui command. install.sh links it from inside goui.app, so an update brings its own copy.
set -eu
label=com.goui.app
plist="$HOME/Library/LaunchAgents/$label.plist"
log="$HOME/Library/Logs/goui.log"
app="$HOME/Applications/goui.app"
link="$HOME/.local/bin/goui"
domain="gui/$(id -u)"
support="$HOME/Library/Application Support/goui"
# The app watches this folder for the request and takes it away once it has the name. SupportFile in Places.swift names the same files.
set_requests="$support/set-requests"
set_request="$set_requests/set-request"
poll_seconds=0.2
# The app takes a request at once, so 3 seconds with no pickup means it is not running.
pickup_wait_seconds=3
# The page can take 15 seconds to load just after launch, so the answer gets a little longer.
answer_wait_seconds=20

is_loaded() {
  launchctl print "$domain/$label" >/dev/null 2>&1
}

stop_agent() {
  launchctl bootout "$domain/$label" 2>/dev/null || true
  # bootout returns before the app has gone, and a bootstrap fails while it is still there.
  while is_loaded; do sleep 0.2; done
}

# Waits while the test holds, up to a number of seconds. Fails once the time is up.
wait_while() {
  wait_seconds=$1
  shift
  tries=$(awk -v total="$wait_seconds" -v step="$poll_seconds" 'BEGIN { print int(total / step) }')
  while "$@"; do
    [ "$tries" -gt 0 ] || return 1
    sleep "$poll_seconds"
    tries=$((tries - 1))
  done
}

is_request_waiting() {
  [ -e "$set_request" ]
}

is_answer_missing() {
  [ ! -e "$set_result" ]
}

# The app owns the Set list, as the panel does, so the answer comes from the app. It exits with 0 only once the Set plays.
apply_set() {
  name="$1"
  id="$$-$(date +%s)"
  set_result="$support/set-result-$id"
  mkdir -p "$set_requests"

  # The request is written beside the folder and moved in, so the app never reads half of it and its watch wakes once.
  printf '%s\n%s' "$id" "$name" >"$support/set-request.part"
  mv -f "$support/set-request.part" "$set_request"

  if ! wait_while "$pickup_wait_seconds" is_request_waiting; then
    rm -f "$set_request"
    echo "goui is not running, so the Set did not change. Run goui start, then try again." >&2
    exit 1
  fi
  if ! wait_while "$answer_wait_seconds" is_answer_missing; then
    echo "goui heard the request but did not answer. goui logs says more." >&2
    exit 1
  fi

  answer=$(head -n 1 "$set_result")
  names=$(tail -n +2 "$set_result")
  rm -f "$set_result"

  case "$answer" in
  applied)
    echo "goui plays the Set \"$name\"."
    ;;
  unknown)
    if [ -z "$names" ]; then
      echo "goui has no Sets yet. Save one in the panel, under Library, then Sets." >&2
    else
      echo "goui has no Set called \"$name\". Your Sets are:" >&2
      printf '%s\n' "$names" | sed 's/^/  /' >&2
    fi
    exit 1
    ;;
  tooManyBands)
    echo "The Set \"$name\" holds more bands than goui plays at once, so the sound did not change." >&2
    exit 1
    ;;
  refused)
    echo "The engine refused the sound of the Set \"$name\". goui logs says why." >&2
    exit 1
    ;;
  replaced)
    echo "Another Set was asked for before goui was ready, so \"$name\" did not play." >&2
    exit 1
    ;;
  *)
    echo "The panel did not load, so the Set \"$name\" did not play. Pick Reload panel in the menu and try again." >&2
    exit 1
    ;;
  esac
}

case "${1:-}" in
start)
  if is_loaded; then
    launchctl kickstart "$domain/$label"
  else
    launchctl bootstrap "$domain" "$plist"
  fi
  echo "goui is running."
  ;;
stop)
  stop_agent
  echo "goui is stopped until you run goui start or log in again."
  ;;
restart)
  if is_loaded; then
    launchctl kickstart -k "$domain/$label"
  else
    launchctl bootstrap "$domain" "$plist"
  fi
  echo "goui started again."
  ;;
rollback)
  previous="$HOME/Applications/goui.app.previous"
  if [ ! -d "$previous" ]; then
    echo "goui has no earlier app to go back to." >&2
    exit 2
  fi
  stop_agent
  rm -rf "$app"
  mv "$previous" "$app"
  if [ -d "$support/web.previous" ]; then
    rm -rf "$support/web"
    mv "$support/web.previous" "$support/web"
  fi
  rm -f "$support/web-version"
  launchctl bootstrap "$domain" "$plist"
  echo "goui went back to the earlier app. Pick Reload panel if the panel is open."
  ;;
set)
  if [ -z "${2:-}" ]; then
    echo 'Usage: goui set "name of a Set"' >&2
    exit 2
  fi
  apply_set "$2"
  ;;
logs)
  tail -n 40 -f "$log"
  ;;
uninstall)
  stop_agent
  rm -f "$plist" "$link"
  rm -rf "$app"
  echo "goui is removed. Your settings stay in ~/Library/Application Support/goui, and its log in $log."
  ;;
*)
  echo 'Usage: goui start | stop | restart | set "name" | logs | rollback | uninstall' >&2
  exit 2
  ;;
esac
