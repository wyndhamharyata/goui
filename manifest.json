{
  "manifest_version": 3,
  "name": "goui",
  "version": "0.1.4",
  "description": "Browser level EQ joining AutoEQ and EQByEar. Different ear, different head, different sound.",
  "homepage_url": "https://goui.mwyndham.dev",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "sidePanel"],
  "host_permissions": ["https://raw.githubusercontent.com/jaakkopasanen/AutoEq/*"],
  "background": { "service_worker": "src/service-worker.js", "type": "module" },
  "side_panel": { "default_path": "src/panel.html" },
  "action": {
    "default_title": "goui",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
